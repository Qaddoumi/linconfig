<?xml version='1.0' encoding='UTF-8'?>
<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <!--
    macOS VM using LongQT-sea/OpenCore-ISO (github.com/LongQT-sea/OpenCore-ISO)
    - no OVMF patches, no kernel patches - stock Arch edk2-ovmf firmware plus
    this project's OpenCore ISO as a CD/DVD.

    INSTALL-PHASE layout (three boot devices):
      1. LongQT-OpenCore-v0.7.iso   - the bootloader        (cdrom)
      2. your macOS installer ISO  - from macos-iso-builder (cdrom)
      3. mac_hdd.qcow2             - blank target disk       (disk)

    BEFORE USE:
      - replace every CHANGEME path below
      - qemu-img create -f qcow2 /home/CHANGEME/macos-vm/mac_hdd.qcow2 256G
      - virt-xml-validate macos-opencore-iso.xml
      - virsh -\-connect qemu:///system define macos-opencore-iso.xml

    No manual PCI <address> bookkeeping here on purpose - libvirt/virt-manager
    auto-assigns PCI slots and root ports for anything left unspecified, which
    is the normal, supported way to hand it a domain like this.

    AFTER install + the Mount_EFI.command post-install step (see chat), you
    can delete both cdrom <disk> blocks below (or just detach them in
    virt-manager) - the target disk becomes self-booting once OpenCore is
    copied onto its own EFI partition, so the ISOs are no longer needed.
  -->
  <name>301-MacOS</name>
  <uuid>b049536a-f7d1-45f2-b9ae-2d9bfc0b31c1</uuid>
  <title>macOS (OpenCore-ISO)</title>
  <memory unit='KiB'>8388608</memory>       <!-- 8 GiB - README's floor is 2 GiB, 4+ recommended -->
  <currentMemory unit='KiB'>8388608</currentMemory>
  <vcpu placement='static'>4</vcpu>          <!-- keep to a power of 2: 1/2/4/8/16/32/64 -->
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' type='pflash'>/usr/share/edk2/x64/OVMF_CODE.4m.fd</loader>
    <nvram template='/usr/share/edk2/x64/OVMF_VARS.4m.fd'>/var/lib/libvirt/qemu/nvram/macos-opencore-iso_VARS.fd</nvram>
    <!-- Secure Boot deliberately OFF here (non-secboot firmware pair above) -
         matches "untick Pre-Enroll Keys" in the Proxmox guide -->
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <clock offset='utc'>
    <!-- Darwin's tsc-based timekeeping needs this or you'll get bad clock drift -->
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- 1. OpenCore-ISO bootloader -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/moh/macos-vm/LongQT-OpenCore-v0.7.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='1'/>
    </disk>

    <!-- 2. macOS installer/recovery ISO -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/moh/macos-vm/macOS_Tahoe_26.5.2.iso'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <!-- 3. Target disk. virtio = better perf (macOS 10.15-26 only).
         Switch bus='sata' dev='sdc' for macOS 10.4-10.14 - see the disk-bus
         table in chat. discard='unmap' passes through TRIM on SATA/virtio. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='writeback' discard='unmap'/>
      <source file='/home/moh/macos-vm/301-MacOS.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <boot order='3'/>
    </disk>

    <!-- ich9 EHCI+UHCI companion group - proven-compatible USB controller
         set for macOS guests -->
    <controller type='usb' index='0' model='ich9-ehci1'>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x07' function='0x7'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci1'>
      <master startport='0'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x07' function='0x0' multifunction='on'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci2'>
      <master startport='2'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x07' function='0x1'/>
    </controller>
    <controller type='usb' index='0' model='ich9-uhci3'>
      <master startport='4'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x07' function='0x2'/>
    </controller>

    <!-- virtio = macOS 11-26 (default/recommended by the project).
         Swap model type='vmxnet3' for macOS 10.11-10.15, type='e1000' for 10.4-10.10 -->
    <interface type='bridge'>
      <mac address='52:54:00:8a:1e:6c'/>
      <source bridge='virbr0'/>
      <model type='virtio'/>
    </interface>

    <serial type='pty'>
      <target type='isa-serial' port='0'>
        <model name='isa-serial'/>
      </target>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>

    <graphics type='spice' autoport='yes'>
      <listen type='address'/>
    </graphics>
    <video>
      <model type='virtio' heads='1' primary='yes'/>
    </video>

    <memballoon model='none'/>   <!-- README: leave ballooning disabled -->
  </devices>

  <qemu:commandline>
    <!-- DEFAULT: modern Intel host, macOS 10.11-26. See the CPU variants
         table in chat for AMD / HEDT / Haswell / old-macOS substitutes -
         only keep ONE -cpu line active. Avoid host-passthrough (the
         project's own benchmarks show it noticeably slower than this). -->
    <qemu:arg value='-cpu'/>
    <qemu:arg value='Skylake-Client-v4'/>

    <qemu:arg value='-device'/>
    <qemu:arg value='usb-tablet'/>
    <qemu:arg value='-device'/>
    <qemu:arg value='usb-kbd'/>
  </qemu:commandline>
</domain>